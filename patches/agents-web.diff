+			toolCalls: toolCalls?.length ? toolCalls : undefined,
+			usage: body.usage ? { promptTokens: body.usage.input_tokens, completionTokens: body.usage.output_tokens } : undefined,
+		};
+	}
+
+	private _parseBootstrap(value: string): { providers: ReadonlyMap<string, IResolvedEnvironmentByokProvider>; models: readonly IByokLmModelInfo[]; status: AgentHostByokStatus } {
+		const bootstrap = JSON.parse(value) as IEnvironmentByokBootstrap;
+		const configuration = bootstrap.configuration;
+		if (!configuration || configuration.error || configuration.version !== 1 || !Array.isArray(configuration.providers)) {
