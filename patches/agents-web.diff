+export interface IAnthropicMessagesRequest {
+	readonly model?: string;
+	readonly system?: string | readonly IAnthropicContentBlock[];
+	readonly messages?: readonly { role?: string; content?: string | readonly IAnthropicContentBlock[] }[];
+	readonly tools?: readonly { name?: string; description?: string; input_schema?: object }[];
