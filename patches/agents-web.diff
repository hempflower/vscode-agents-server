+				};
+				providerModels.set(resolvedModel.id, resolvedModel);
+			}
+			const apiKey = secrets[candidate.apiKeyEnv];
+			if (!apiKey) {
+				this._logService.warn(`[EnvironmentBYOK] Provider '${candidate.id}' is disabled because '${candidate.apiKeyEnv}' is missing`);
+				providerStatuses.push({ providerId: candidate.id!, models: [...providerModels.keys()], errorCode: 'missing_api_key' });
+				continue;
+			}
+			providerStatuses.push({ providerId: candidate.id!, models: [...providerModels.keys()] });
+			for (const resolvedModel of providerModels.values()) {
+				models.push({
+					vendor: candidate.id!,
+					id: resolvedModel.id,
+					name: resolvedModel.name,
+					modelIdentifier: `${candidate.id}/${resolvedModel.id}`,
+					maxContextWindowTokens: resolvedModel.maxContextWindowTokens,
+					...(resolvedModel.maxOutputTokens !== undefined ? { maxOutputTokens: resolvedModel.maxOutputTokens } : {}),
+					supportsVision: resolvedModel.supportsVision,
+					sdkProviderType: candidate.type === 'openai' ? 'openai' : 'anthropic',
+					...(resolvedModel.supportedReasoningEfforts ? { supportedReasoningEfforts: resolvedModel.supportedReasoningEfforts } : {}),
+					...(resolvedModel.defaultReasoningEffort ? { defaultReasoningEffort: resolvedModel.defaultReasoningEffort } : {}),
+				});
+			}
+			providers.set(candidate.id!, {
+				id: candidate.id!,
+				type: candidate.type,
+				baseUrl: candidate.baseUrl.replace(/\/+$/, ''),
+				apiKey,
+				apiVersion: candidate.apiVersion ?? '2023-06-01',
