+			}
+			if (providers.has(candidate.id!)) {
+				throw new Error(`Duplicate BYOK provider id '${candidate.id}'`);
+			}
+			const url = new URL(candidate.baseUrl);
+			if (url.protocol !== 'https:' && !(url.protocol === 'http:' && candidate.allowInsecureHttp === true)) {
+				throw new Error(`BYOK provider '${candidate.id}' must use HTTPS`);
+			}
+			const providerModels = new Map<string, IResolvedEnvironmentByokModel>();
+			for (const model of candidate.models) {
+				if (!model || !providerIdPattern.test(model.id ?? '')) {
+					throw new Error(`Invalid model in BYOK provider '${candidate.id}'`);
+				}
+				const selectionId = `${candidate.id}/${model.id}`;
+				if (selectionIds.has(selectionId)) {
+					throw new Error(`Duplicate BYOK model id '${selectionId}'`);
+				}
+				selectionIds.add(selectionId);
+				const resolvedModel: IResolvedEnvironmentByokModel = {
+					id: model.id!,
+					name: model.name,
+					maxContextWindowTokens: positiveNumber(model.maxContextWindowTokens),
+					maxOutputTokens: positiveNumber(model.maxOutputTokens),
+					supportsVision: model.supportsVision === true,
+					supportedReasoningEfforts: parseReasoningEfforts(model.supportedReasoningEfforts, model.defaultReasoningEffort),
