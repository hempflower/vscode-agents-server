+			throw isDeepSeek ? await deepSeekHttpError(response) : providerHttpError(response.status);
+		}
+		if (response.headers.get('content-type')?.includes('text/event-stream')) {
+			return readAnthropicStream(response, onProgress);
+		}
+		const body = await response.json() as {
+			content?: ({ type?: 'text'; text?: string } | { type?: 'thinking'; thinking?: string; signature?: string } | { type?: 'tool_use'; id?: string; name?: string; input?: object })[];
+			usage?: { input_tokens?: number; output_tokens?: number };
