+
+function blocksText(blocks: readonly IAnthropicContentBlock[] | undefined): string {
+	return blocks?.filter(block => block.type === 'text').map(block => block.text ?? '').join('') ?? '';
+}
+
+function imageBlockUrl(block: IAnthropicContentBlock): string | undefined {
+	if (block.source?.type === 'base64' && block.source.media_type && block.source.data) {
+		return `data:${block.source.media_type};base64,${block.source.data}`;
+	}
+	return block.source?.type === 'url' ? block.source.url : undefined;
