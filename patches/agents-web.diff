+
+function toToolCalls(toolCalls: { id?: string; function?: { name?: string; arguments?: string } }[] | undefined): IByokLmToolCall[] | undefined {
+	const result = toolCalls?.filter(call => !!call.function?.name).map((call, index) => ({
+		id: call.id ?? `call_${index}`,
+		name: call.function!.name!,
+		argumentsJson: call.function?.arguments ?? '{}',
+	}));
+	return result?.length ? result : undefined;
+}
+
+async function readOpenAiStream(response: Response, onProgress?: (progress: IByokLmChatProgress) => void): Promise<IByokLmChatResult> {
+	let content = '';
+	let reasoningText = '';
+	let reasoningOpaque: string | undefined;
+	let promptTokens: number | undefined;
+	let completionTokens: number | undefined;
+	const toolCalls = new Map<number, IByokLmToolCall>();
+	let receivedEvent = false;
+	for await (const event of readSseJson(response)) {
+		receivedEvent = true;
+		const value = event as {
+			choices?: { delta?: { content?: string; reasoning_content?: string; reasoning_opaque?: string; tool_calls?: { index?: number; id?: string; function?: { name?: string; arguments?: string } }[] } }[];
+			usage?: { prompt_tokens?: number; completion_tokens?: number };
+		};
+		const delta = value.choices?.[0]?.delta;
+		const contentDelta = delta?.content ?? '';
+		content += contentDelta;
+		const reasoningTextDelta = delta?.reasoning_content ?? '';
+		reasoningText += reasoningTextDelta;
+		reasoningOpaque = delta?.reasoning_opaque ?? reasoningOpaque;
+		const toolCallDeltas: { index: number; id?: string; nameDelta?: string; argumentsDelta?: string }[] = [];
+		for (const call of delta?.tool_calls ?? []) {
+			const index = call.index ?? 0;
+			const current = toolCalls.get(index) ?? { id: call.id ?? `call_${index}`, name: '', argumentsJson: '' };
+			toolCalls.set(index, {
+				id: call.id ?? current.id,
+				name: current.name + (call.function?.name ?? ''),
+				argumentsJson: current.argumentsJson + (call.function?.arguments ?? ''),
+			});
+			toolCallDeltas.push({ index, id: call.id, nameDelta: call.function?.name, argumentsDelta: call.function?.arguments });
+		}
+		if (contentDelta || reasoningTextDelta || toolCallDeltas.length) {
+			onProgress?.({ contentDelta: contentDelta || undefined, reasoningTextDelta: reasoningTextDelta || undefined, toolCallDeltas: toolCallDeltas.length ? toolCallDeltas : undefined });
+		}
+		promptTokens = value.usage?.prompt_tokens ?? promptTokens;
+		completionTokens = value.usage?.completion_tokens ?? completionTokens;
+	}
+	if (!receivedEvent) {
+		throw new EnvironmentByokRequestError('invalid_provider_response');
+	}
+	return {
+		content,
+		...(reasoningText ? { reasoningText } : {}),
+		...(reasoningOpaque ? { reasoningOpaque } : {}),
+		toolCalls: toolCalls.size ? [...toolCalls.values()] : undefined,
+		usage: promptTokens !== undefined || completionTokens !== undefined ? { promptTokens, completionTokens } : undefined,
+	};
+}
+
+async function readAnthropicStream(response: Response, onProgress?: (progress: IByokLmChatProgress) => void): Promise<IByokLmChatResult> {
+	let content = '';
+	let reasoningText = '';
+	let reasoningOpaque: string | undefined;
+	let promptTokens: number | undefined;
+	let completionTokens: number | undefined;
+	const toolCalls = new Map<number, IByokLmToolCall>();
+	const toolIndexesByContentBlock = new Map<number, number>();
+	let receivedEvent = false;
+	for await (const event of readSseJson(response)) {
+		receivedEvent = true;
+		const value = event as {
+			index?: number;
+			message?: { usage?: { input_tokens?: number; output_tokens?: number } };
+			usage?: { output_tokens?: number };
+			content_block?: { type?: string; id?: string; name?: string; input?: object; thinking?: string; signature?: string };
+			delta?: { type?: string; text?: string; thinking?: string; signature?: string; partial_json?: string };
+		};
+		promptTokens = value.message?.usage?.input_tokens ?? promptTokens;
+		completionTokens = value.usage?.output_tokens ?? value.message?.usage?.output_tokens ?? completionTokens;
+		if (value.delta?.type === 'text_delta') {
+			const contentDelta = value.delta.text ?? '';
+			content += contentDelta;
+			if (contentDelta) {
+				onProgress?.({ contentDelta });
+			}
+		}
+		if (value.content_block?.type === 'thinking') {
+			const initialThinking = value.content_block.thinking ?? '';
+			reasoningText += initialThinking;
+			reasoningOpaque = value.content_block.signature || reasoningOpaque;
+			if (initialThinking) {
+				onProgress?.({ reasoningTextDelta: initialThinking });
+			}
+		} else if (value.delta?.type === 'thinking_delta') {
+			const reasoningDelta = value.delta.thinking ?? '';
+			reasoningText += reasoningDelta;
+			if (reasoningDelta) {
+				onProgress?.({ reasoningTextDelta: reasoningDelta });
+			}
+		} else if (value.delta?.type === 'signature_delta') {
+			reasoningOpaque = `${reasoningOpaque ?? ''}${value.delta.signature ?? ''}` || undefined;
+		}
+		const contentBlockIndex = value.index ?? 0;
+		if (value.content_block?.type === 'tool_use') {
+			const index = toolIndexesByContentBlock.size;
+			toolIndexesByContentBlock.set(contentBlockIndex, index);
+			const initialInput = value.content_block.input;
+			toolCalls.set(index, {
+				id: value.content_block.id ?? `call_${index}`,
+				name: value.content_block.name ?? '',
+				argumentsJson: initialInput && Object.keys(initialInput).length ? JSON.stringify(initialInput) : '',
+			});
+			onProgress?.({ toolCallDeltas: [{ index, id: value.content_block.id, nameDelta: value.content_block.name }] });
+		} else if (value.delta?.type === 'input_json_delta') {
+			const index = toolIndexesByContentBlock.get(contentBlockIndex) ?? toolIndexesByContentBlock.size;
+			toolIndexesByContentBlock.set(contentBlockIndex, index);
+			const current = toolCalls.get(index) ?? { id: `call_${index}`, name: '', argumentsJson: '' };
+			toolCalls.set(index, { ...current, argumentsJson: current.argumentsJson + (value.delta.partial_json ?? '') });
+			if (value.delta.partial_json) {
+				onProgress?.({ toolCallDeltas: [{ index, argumentsDelta: value.delta.partial_json }] });
+			}
+		}
+	}
+	if (!receivedEvent) {
+		throw new EnvironmentByokRequestError('invalid_provider_response');
+	}
+	return {
+		content,
+		...(reasoningText ? { reasoningText } : {}),
+		...(reasoningOpaque ? { reasoningOpaque } : {}),
+		toolCalls: toolCalls.size ? [...toolCalls.values()].map(call => ({ ...call, argumentsJson: call.argumentsJson || '{}' })) : undefined,
+		usage: promptTokens !== undefined || completionTokens !== undefined ? { promptTokens, completionTokens } : undefined,
+	};
+}
+
+async function* readSseJson(response: Response): AsyncGenerator<unknown> {
+	if (!response.body) {
+		throw new Error('Streaming BYOK response has no body');
+	}
+	const reader = response.body.getReader();
+	const decoder = new TextDecoder();
+	let buffer = '';
+	while (true) {
+		const { done, value } = await reader.read();
+		buffer += decoder.decode(value, { stream: !done });
+		const blocks = buffer.split(/\r?\n\r?\n/);
+		buffer = done ? '' : blocks.pop() ?? '';
+		for (const block of blocks) {
+			const data = block.split(/\r?\n/).filter(line => line.startsWith('data:')).map(line => line.slice(5).trimStart()).join('\n');
+			if (data && data !== '[DONE]') {
+				yield JSON.parse(data);
+			}
+		}
+		if (done) {
+			break;
+		}
+	}
+}
+
+function providerHttpError(status: number): EnvironmentByokRequestError {
+	if (status === 401 || status === 403) {
+		return new EnvironmentByokRequestError('authentication_failed');
+	}
+	if (status === 408 || status === 504) {
+		return new EnvironmentByokRequestError('provider_timeout');
+	}
+	if (status === 429) {
+		return new EnvironmentByokRequestError('rate_limited');
+	}
+	if (status >= 500) {
+		return new EnvironmentByokRequestError('provider_unavailable');
+	}
+	return new EnvironmentByokRequestError('provider_rejected_request');
+}
+
+/**
+ * DeepSeek returns the actionable thinking-round-trip reason in its 400 error
+ * envelope. Parse only known categories and discard the provider text so no
+ * endpoint response body is copied into logs or session state.
+ */
+async function deepSeekHttpError(response: Response): Promise<EnvironmentByokRequestError> {
+	if (response.status !== 400 && response.status !== 422) {
+		return providerHttpError(response.status);
+	}
+	try {
+		const body = await response.json() as { error?: { message?: unknown; code?: unknown }; message?: unknown };
+		const providerMessage = typeof body.error?.message === 'string'
+			? body.error.message
+			: typeof body.message === 'string' ? body.message : '';
+		const providerCode = typeof body.error?.code === 'string' ? body.error.code : '';
+		const diagnostic = `${providerCode} ${providerMessage}`.toLowerCase();
+		if (diagnostic.includes('reasoning_content') || diagnostic.includes('thinking block') || diagnostic.includes('thinking signature')) {
+			return new EnvironmentByokRequestError('missing_reasoning_content');
+		}
+		if (diagnostic.includes('tool_use') || diagnostic.includes('tool_result')) {
+			return new EnvironmentByokRequestError('invalid_tool_result_sequence');
+		}
+		if (diagnostic.includes('context length') || diagnostic.includes('context_length')) {
+			return new EnvironmentByokRequestError('context_length_exceeded');
+		}
+	} catch {
+		// A malformed/empty error body still maps deterministically by status.
+	}
+	return new EnvironmentByokRequestError('provider_rejected_request');
+}
+
+function positiveNumber(value: number | undefined): number | undefined {
+	return typeof value === 'number' && Number.isFinite(value) && value > 0 ? value : undefined;
+}
+
+function numericOption(value: unknown): number | undefined {
+	return typeof value === 'number' && Number.isFinite(value) ? value : undefined;
+}
