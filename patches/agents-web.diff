+
+function toOpenAiMessage(message: IByokLmChatMessage): object {
+	if (message.role === 'assistant' && message.toolCalls?.length) {
+		return {
+			role: 'assistant',
+			content: message.content || null,
+			...(message.reasoningText ? { reasoning_content: message.reasoningText } : {}),
+			...(message.reasoningOpaque ? { reasoning_opaque: message.reasoningOpaque } : {}),
+			tool_calls: message.toolCalls.map(call => ({ id: call.id, type: 'function', function: { name: call.name, arguments: call.argumentsJson } })),
+		};
+	}
+	if (message.role === 'tool') {
+		return { role: 'tool', content: message.content, tool_call_id: message.toolCallId };
+	}
+	if (message.imageUrls?.length) {
+		return {
+			role: message.role,
+			content: [
+				...(message.content ? [{ type: 'text', text: message.content }] : []),
+				...message.imageUrls.map(url => ({ type: 'image_url', image_url: { url } })),
+			],
+		};
+	}
+	return {
+		role: message.role,
+		content: message.content,
+		...(message.role === 'assistant' && message.reasoningText ? { reasoning_content: message.reasoningText } : {}),
+		...(message.role === 'assistant' && message.reasoningOpaque ? { reasoning_opaque: message.reasoningOpaque } : {}),
+	};
+}
+
+function toAnthropicMessage(message: IByokLmChatMessage): object {
