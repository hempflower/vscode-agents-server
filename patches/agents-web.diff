+		}
+		const secrets = bootstrap.secrets ?? {};
+		const providers = new Map<string, IResolvedEnvironmentByokProvider>();
+		const models: IByokLmModelInfo[] = [];
+		const providerStatuses: AgentHostByokProviderStatus[] = [];
+		const selectionIds = new Set<string>();
+
+		for (const candidate of configuration.providers) {
+			if (!candidate || !providerIdPattern.test(candidate.id ?? '') || (candidate.type !== 'openai' && candidate.type !== 'anthropic' && candidate.type !== 'deepseek') || !candidate.baseUrl || !candidate.apiKeyEnv || !Array.isArray(candidate.models)) {
