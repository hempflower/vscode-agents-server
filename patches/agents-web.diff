+			});
+		}
+		const disabledProviders = providerStatuses.filter(provider => provider.errorCode).length;
+		const state = models.length === 0 ? 'disabled' : disabledProviders > 0 ? 'degraded' : 'ready';
+		return { providers, models, status: { state, providers: providerStatuses } };
+	}
