+
+function anthropicThinkingOptions(value: unknown): object {
+	if (value === 'none') {
+		return { thinking: { type: 'disabled' } };
+	}
+	if (typeof value === 'string' && value) {
+		return { thinking: { type: 'enabled' }, output_config: { effort: value } };
+	}
+	return {};
