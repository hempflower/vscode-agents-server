+	const emit = (event: string, data: object) => frames.push(`event: ${event}\ndata: ${JSON.stringify(data)}\n\n`);
+	emit('message_start', { type: 'message_start', message: { id, type: 'message', role: 'assistant', model, content: [], stop_reason: null, stop_sequence: null, usage: { input_tokens: result.usage?.promptTokens ?? 0, output_tokens: 0 } } });
