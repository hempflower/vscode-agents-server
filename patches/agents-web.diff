+
+function parseReasoningEfforts(value: unknown, defaultValue: unknown): readonly string[] | undefined {
+	if (value === undefined && defaultValue === undefined) {
+		return undefined;
+	}
+	if (!Array.isArray(value) || value.length === 0 || value.some(item => typeof item !== 'string' || !providerIdPattern.test(item))) {
+		throw new Error('Invalid supportedReasoningEfforts');
+	}
+	if (typeof defaultValue !== 'string' || !value.includes(defaultValue)) {
+		throw new Error('Invalid defaultReasoningEffort');
+	}
+	return [...value];
+}
