+				...(blocks?.filter(block => block.type === 'thinking').map(block => block.thinking ?? '').join('') ? {
+					reasoningText: blocks.filter(block => block.type === 'thinking').map(block => block.thinking ?? '').join(''),
+				} : {}),
+				...(blocks?.find(block => block.type === 'thinking' && block.signature)?.signature ? {
+					reasoningOpaque: blocks.find(block => block.type === 'thinking' && block.signature)!.signature,
+				} : {}),
