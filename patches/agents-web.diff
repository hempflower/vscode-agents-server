+		if (result.reasoningOpaque) {
+			emit('content_block_delta', { type: 'content_block_delta', index, delta: { type: 'signature_delta', signature: result.reasoningOpaque } });
+		}
+		emit('content_block_stop', { type: 'content_block_stop', index: index++ });
+	}
+	if (result.content) {
+		emit('content_block_start', { type: 'content_block_start', index, content_block: { type: 'text', text: '' } });
+		emit('content_block_delta', { type: 'content_block_delta', index, delta: { type: 'text_delta', text: result.content } });
+		emit('content_block_stop', { type: 'content_block_stop', index: index++ });
+	}
+	for (const call of result.toolCalls ?? []) {
+		emit('content_block_start', { type: 'content_block_start', index, content_block: { type: 'tool_use', id: call.id, name: call.name, input: {} } });
+		emit('content_block_delta', { type: 'content_block_delta', index, delta: { type: 'input_json_delta', partial_json: call.argumentsJson } });
+		emit('content_block_stop', { type: 'content_block_stop', index: index++ });
+	}
