+	private async _chatOpenAi(provider: IResolvedEnvironmentByokProvider, model: IResolvedEnvironmentByokModel, request: IByokLmChatRequest, signal: AbortSignal, onProgress?: (progress: IByokLmChatProgress) => void): Promise<IByokLmChatResult> {
+		const response = await this._fetch(`${provider.baseUrl}/chat/completions`, {
+			method: 'POST',
+			headers: {
+				'Authorization': `Bearer ${provider.apiKey}`,
+				'Content-Type': 'application/json',
