diff --git a/lib/vscode/src/vs/workbench/contrib/chat/browser/agentSessions/agentHost/agentHostSessionHandler.ts b/lib/vscode/src/vs/workbench/contrib/chat/browser/agentSessions/agentHost/agentHostSessionHandler.ts
--- a/lib/vscode/src/vs/workbench/contrib/chat/browser/agentSessions/agentHost/agentHostSessionHandler.ts
+++ b/lib/vscode/src/vs/workbench/contrib/chat/browser/agentSessions/agentHost/agentHostSessionHandler.ts
@@ -618,6 +618,13 @@ class AgentHostChatSession extends Disposable implements IChatSession {
 	 * flow to stream ongoing state changes into the chat UI.
 	 */
 	appendProgress(items: IChatProgress[]): void {
+		// State subscriptions and asynchronous helpers can deliver a final
+		// update after the turn's terminal state has already completed the chat
+		// response. Do not let a stale update poison the UI's progress stream.
+		if (this.isCompleteObs.get()) {
+			this._logService.trace(`[AgentHost] Ignoring ${items.length} progress item(s) after response completion`);
+			return;
+		}
 		const current = this.progressObs.get();
 		this.progressObs.set([...current, ...items], undefined);
 	}
