 				// Process only new progress items
 				if (lastRequest && progressArray.length > lastProgressLength) {
 					const newProgress = progressArray.slice(lastProgressLength);
-					for (const progress of newProgress) {
-						model?.acceptResponseProgress(lastRequest, progress);
+					if (lastRequest.response?.isComplete) {
+						// A contributed remote session may publish a delayed state
+						// update after it has marked the turn complete. The ChatModel
+						// correctly rejects such updates; ignore them here so one stale
+						// event cannot break all subsequent UI reconciliation.
+						this.trace('loadRemoteSession', `Ignoring ${newProgress.length} progress item(s) for a completed response in ${model.sessionResource}`);
+					} else {
+						for (const progress of newProgress) {
+							model.acceptResponseProgress(lastRequest, progress);
+						}
 					}
 					lastProgressLength = progressArray.length;
 				}
